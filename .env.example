# Required Environment Variables

# Bearer token for API authentication (required for all API calls)
BEARER_TOKEN=your_bearer_token_here

# Bearer token for fetching dynamic tool definitions (optional)
# If not set, dynamic tools will not be loaded
FETCH_BEARER_TOKEN=your_fetch_bearer_token_here

# Gemini API key for knowledge base search (optional)
# If not set, knowledge base search will not be available
GEMINI_API_KEY=your_gemini_api_key_here

# Source identifier for API calls (optional, default: MCP)
SOURCE=MCP

# API Base URLs (optional, defaults are provided)
# API_BASE_URL=https://api.marketmaya.com/api
# WEBAPI_BASE_URL=https://webapi.marketmaya.com/api
